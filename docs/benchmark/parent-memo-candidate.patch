--- /dev/null
+++ b/src/hook/useParentMemo.ts
@@ -0,0 +1,237 @@
+import type {
+  ComponentInfo,
+  CompKey,
+  Props,
+  TagFunctionResolver,
+  WDom,
+} from '@/types';
+import { componentMap, getCurrentComponent } from '@/utils/universalRef';
+
+type Snapshot = { keys: string[]; deps: unknown[] };
+type Memo = {
+  dependencies: (props: Props) => readonly unknown[];
+  version: number;
+  snapshot?: Snapshot;
+  pending?: Snapshot;
+};
+type Output = { component: ComponentInfo; memo: Memo; version: number };
+type Work = {
+  touched?: Map<Memo, number>;
+  outputs?: Map<WDom, Output>;
+  created?: Set<ComponentInfo>;
+};
+
+const memos = new WeakMap<ComponentInfo, Memo>();
+const outputs = new WeakMap<WDom, Output>();
+let setup: ComponentInfo | undefined;
+let work: Work | undefined;
+
+const invalidate = (memo: Memo) => {
+  memo.version++;
+  memo.snapshot = memo.pending = undefined;
+};
+const touch = (memo: Memo) => {
+  if (work) (work.touched ||= new Map()).set(memo, memo.version);
+};
+const forget = (component: ComponentInfo) => {
+  const memo = memos.get(component);
+  if (memo) {
+    invalidate(memo);
+    memo.dependencies = () => [];
+    memos.delete(component);
+  }
+};
+
+/**
+ * Opt into skipping parent-driven renders with unchanged declared inputs.
+ * Call once during mount/lmount setup. Self renew always renders. Nonempty
+ * slots and unsupported props fall back to the ordinary component path.
+ */
+export const useParentMemo = <P extends object = Props>(
+  dependencies: (nextProps: Readonly<P>) => readonly unknown[]
+): void => {
+  const component = getCurrentComponent();
+  if (!component || setup !== component || memos.has(component)) {
+    throw new Error('useParentMemo must be called once during component setup');
+  }
+  if (typeof dependencies !== 'function') {
+    throw new TypeError('useParentMemo requires a dependency selector');
+  }
+  memos.set(component, {
+    dependencies: dependencies as Memo['dependencies'],
+    version: 0,
+  });
+  if (work) (work.created ||= new Set()).add(component);
+  // Clear even if a later user cleanup throws, including manual map mode.
+  component.umts.unshift(() => forget(component));
+};
+
+export const withParentMemoSetup = <T>(key: CompKey, action: () => T): T => {
+  const previous = setup;
+  setup = componentMap.get(key);
+  try {
+    return action();
+  } finally {
+    setup = previous;
+  }
+};
+
+export const forgetParentMemo = (key: CompKey) => {
+  const component = componentMap.get(key);
+  if (component) forget(component);
+};
+
+// Inspect descriptors without invoking accessors. Exotic inputs keep the
+// baseline path; this is not a new props/slot mutation protocol.
+const propKeys = (props: Props): string[] | undefined => {
+  if (
+    !props ||
+    Object.getPrototypeOf(props) !== Object.prototype ||
+    !Object.isExtensible(props)
+  ) {
+    return;
+  }
+  const descriptors = Object.getOwnPropertyDescriptors(props);
+  for (const key of Reflect.ownKeys(descriptors)) {
+    const descriptor = descriptors[key as string];
+    if (
+      descriptor.enumerable &&
+      (typeof key !== 'string' ||
+        !('value' in descriptor) ||
+        !descriptor.writable ||
+        !descriptor.configurable)
+    ) {
+      return;
+    }
+  }
+  return Object.keys(props);
+};
+
+const snapshot = (
+  memo: Memo,
+  props: Props,
+  children: WDom[]
+): Snapshot | undefined => {
+  if (children.length) return;
+  const keys = propKeys(props);
+  if (!keys) return;
+  const deps = memo.dependencies(props);
+  if (!Array.isArray(deps)) {
+    throw new TypeError('useParentMemo selector must return an array');
+  }
+  return { keys, deps: [...deps] };
+};
+
+const sameKeys = (a: string[], b: string[]) =>
+  a.length === b.length && a.every((key, index) => key === b[index]);
+
+export const skipParentUpdate = (
+  node: WDom,
+  incoming: TagFunctionResolver
+): boolean => {
+  const component = node.compKey && componentMap.get(node.compKey);
+  const memo = component && memos.get(component);
+  if (!memo) return false;
+  touch(memo);
+  try {
+    const before = memo.snapshot;
+    const heldKeys = propKeys(node.compProps as Props);
+    if (!before || !heldKeys || node.compChild?.length) return false;
+    const next = snapshot(memo, incoming.props, incoming.children);
+    return !!(
+      next &&
+      sameKeys(before.keys, heldKeys) &&
+      sameKeys(before.keys, next.keys) &&
+      before.deps.length === next.deps.length &&
+      before.deps.every((value, index) => Object.is(value, next.deps[index]))
+    );
+  } catch (error) {
+    invalidate(memo);
+    throw error;
+  }
+};
+
+export const invalidateParentMemo = (key: CompKey | undefined) => {
+  const component = key && componentMap.get(key);
+  const memo = component && memos.get(component);
+  if (memo) {
+    invalidate(memo);
+    touch(memo);
+  }
+};
+
+// Runs after pre-update callbacks, before evaluating the component output.
+export const beginParentMemoOutput = (
+  key: CompKey,
+  props: Props,
+  children: WDom[]
+): Output | undefined => {
+  const component = componentMap.get(key);
+  const memo = component && memos.get(component);
+  if (!component || !memo) return;
+  invalidate(memo);
+  touch(memo);
+  memo.pending = snapshot(memo, props, children);
+  return { component, memo, version: memo.version };
+};
+
+export const stageParentMemoOutput = (
+  node: WDom,
+  output: Output | undefined
+) => {
+  if (output) outputs.set(node, output);
+};
+
+// Called by the base DOM renderer. Creating an eager h() tree does not count
+// as a successful mount, and a speculative output never becomes a cache hit.
+export const visitParentMemoOutput = (node: WDom) => {
+  const output = outputs.get(node);
+  if (output && work) {
+    touch(output.memo);
+    (work.outputs ||= new Map()).set(node, output);
+  }
+};
+
+/** Memo publication only: existing DOM/props mutations are not rolled back. */
+export const withParentMemoWork = <T>(action: () => T): T => {
+  const previous = work;
+  const current: Work = {};
+  work = current;
+  try {
+    const result = action();
+    if (previous) {
+      current.created?.forEach(component =>
+        (previous.created ||= new Set()).add(component)
+      );
+      current.touched?.forEach((version, memo) =>
+        (previous.touched ||= new Map()).set(memo, version)
+      );
+      current.outputs?.forEach((output, node) =>
+        (previous.outputs ||= new Map()).set(node, output)
+      );
+    } else {
+      current.outputs?.forEach(({ component, memo, version }, node) => {
+        if (
+          memo.version === version &&
+          memos.get(component) === memo &&
+          node.compKey &&
+          componentMap.get(node.compKey) === component &&
+          component.vd.value === node &&
+          !node.il
+        ) {
+          memo.snapshot = memo.pending;
+          memo.pending = undefined;
+        }
+      });
+    }
+    return result;
+  } catch (error) {
+    current.touched?.forEach((version, memo) => {
+      if (memo.version === version) invalidate(memo);
+    });
+    current.created?.forEach(forget);
+    throw error;
+  } finally {
+    work = previous;
+  }
+};
