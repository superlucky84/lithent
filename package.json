{
  "type": "module",
  "name": "lithent",
  "version": "1.24.0",
  "description": "An extensible virtual DOM library for lightweight use in a variety of environments.",
  "packageManager": "pnpm@9.12.3",
  "main": "./dist/lithent.cjs",
  "module": "./dist/lithent.mjs",
  "scripts": {
    "dev:core": "vite",
    "dev:concurrent": "pnpm build:concurrentHelper && pnpm --filter lithent-concurrent dev",
    "dev": "vite",
    "dev:examples": "pnpm watch:core & pnpm watch:helper & pnpm watch:devHelper & pnpm --filter lithent-examples dev",
    "dev:helper": "pnpm watch:core & pnpm --filter lithent-helper dev",
    "dev:devHelper": "pnpm watch:core & pnpm --filter lithent-dev-helper dev",
    "dev:ssr": "pnpm watch:core & pnpm --filter lithent-ssr dev",
    "dev:docs": "pnpm watch:core & pnpm watch:helper & pnpm --filter lithent-docs dev",
    "build:core": "vite build && node scripts/build-skills.js",
    "size": "node scripts/size-report.js",
    "bench:units": "pnpm build:core && pnpm build:concurrent && pnpm --filter lithent-concurrent bench",
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "check:scaffold:concurrent": "pnpm build:concurrent && LITHENT_CORE=concurrent node scripts/check-scaffold.mjs",
    "check:consumer": "pnpm build:core && pnpm build:helper && pnpm build:concurrent && LITHENT_CORE=concurrent vite --config lithentConcurrent/consumer/vite.config.js",
    "check:consumer:base": "pnpm build:core && pnpm build:helper && vite --config lithentConcurrent/consumer/vite.config.js",
    "check:lifecycle": "pnpm build:core && pnpm build:concurrent && LITHENT_PAGE=/html/lifecycle.html pnpm --filter lithent-concurrent bench",
    "check:interrupt": "pnpm build:core && pnpm build:concurrent && LITHENT_PAGE=/html/interrupt.html pnpm --filter lithent-concurrent bench",
    "verify:concurrent": "node lithentConcurrent/scripts/verifyArtifacts.js",
    "verify:release": "node scripts/verify-release.mjs",
    "build:concurrent": "pnpm --filter lithent-concurrent build",
    "build:concurrentHelper": "pnpm --filter lithent-concurrent-helper build",
    "build:skills": "node scripts/build-skills.js",
    "build:helper": "pnpm --filter lithent-helper build",
    "build:devHelper": "pnpm --filter lithent-dev-helper build",
    "build:hmrParser": "pnpm --filter @lithent/hmr-parser build",
    "build:lithentTemplateParser": "pnpm --filter @lithent/lithent-template-parser build",
    "build:lithentTemplateVite": "pnpm --filter @lithent/lithent-template-vite build",
    "build:lithentVite": "pnpm --filter @lithent/lithent-vite build",
    "build:lithentMdx": "pnpm --filter @lithent/lithent-mdx build",
    "build:jsxruntime": "pnpm --filter jsx-runtime build",
    "build:ssr": "pnpm --filter lithent-ssr build",
    "build:tag": "pnpm --filter lithent-tag build",
    "build:ftags": "pnpm --filter lithent-ftags build",
    "build:element": "pnpm --filter lithent-element build",
    "playground:element": "pnpm build:core && pnpm build:concurrent && pnpm build:element && pnpm --filter lithent-element playground",
    "build:examples": "pnpm --filter lithent-examples build",
    "build:docs": "pnpm --filter lithent-docs build",
    "build:sequence": "pnpm build:core && pnpm build:concurrent && pnpm build:concurrentHelper && pnpm build:jsxruntime && pnpm build:helper && pnpm build:devHelper && pnpm build:hmrParser && pnpm build:lithentTemplateParser && pnpm build:lithentTemplateVite && pnpm build:lithentMdx && pnpm build:lithentVite && pnpm build:ssr",
    "build:parallel": "pnpm --filter '!lithent-concurrent' --filter '!lithent-concurrent-helper' --filter '!jsx-runtime' --filter '!lithent-helper' --filter '!lithent-dev-helper' --filter '!@lithent/hmr-parser' --filter '!@lithent/lithent-template-parser' --filter '!@lithent/lithent-template-vite' --filter '!@lithent/lithent-mdx' --filter '!@lithent/lithent-vite' --filter '!lithent-ssr' --filter '!create-lithent' build",
    "build": "pnpm run build:sequence && pnpm run build:parallel",
    "watch:core": "vite build --watch",
    "watch:concurrent": "pnpm --filter lithent-concurrent watch",
    "watch:concurrentHelper": "pnpm --filter lithent-concurrent-helper watch",
    "watch:helper": "pnpm --filter lithent-helper watch",
    "watch:devHelper": "pnpm --filter lithent-dev-helper watch",
    "watch:element": "pnpm --filter lithent-element watch",
    "test:core": "vitest run --reporter verbose",
    "test:concurrent": "pnpm --filter lithent-concurrent test && pnpm --filter lithent-concurrent-helper test",
    "test:satellites": "pnpm --filter lithent-helper test && pnpm --filter lithent-dev-helper test && pnpm --filter lithent-ftags test && pnpm --filter lithent-ssr test && pnpm --filter lithent-element test",
    "test:satellites:concurrent": "LITHENT_CORE=concurrent pnpm run test:satellites",
    "test:dual": "pnpm test:core && pnpm test:concurrent && pnpm test:satellites && pnpm test:satellites:concurrent",
    "test": "pnpm test:core && pnpm test:concurrent && pnpm --filter lithent-helper test && pnpm --filter lithent-dev-helper test && pnpm --filter @lithent/hmr-parser test && pnpm --filter @lithent/lithent-mdx test && pnpm --filter @lithent/lithent-vite test && pnpm --filter lithent-ftags test && pnpm --filter lithent-element test",
    "test:lithentMdx": "pnpm --filter @lithent/lithent-mdx test",
    "test:lithentVite": "pnpm --filter @lithent/lithent-vite test",
    "test:dev": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:build": "pnpm build && pnpm test:e2e",
    "test:e2e:mutations": "node e2e/check-mutations.mjs",
    "clean": "pnpm clean:dist && pnpm clean:module",
    "clean:dist": "pnpm -r exec rm -rf dist && rm -rf dist",
    "clean:module": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/lithent.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/lithent.cjs"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./jsx-runtime/dist/index.d.ts",
        "default": "./jsx-runtime/dist/jsxRuntime.mjs"
      },
      "require": {
        "types": "./jsx-runtime/dist/index.d.cts",
        "default": "./jsx-runtime/dist/jsxRuntime.cjs"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./jsx-runtime/dist/index.d.ts",
        "default": "./jsx-runtime/dist/jsxRuntime.mjs"
      },
      "require": {
        "types": "./jsx-runtime/dist/index.d.cts",
        "default": "./jsx-runtime/dist/jsxRuntime.cjs"
      }
    },
    "./helper": {
      "import": {
        "types": "./helper/dist/index.d.ts",
        "default": "./helper/dist/lithentHelper.mjs"
      },
      "require": {
        "types": "./helper/dist/index.d.cts",
        "default": "./helper/dist/lithentHelper.cjs"
      }
    },
    "./devHelper": {
      "import": {
        "types": "./devHelper/dist/index.d.ts",
        "default": "./devHelper/dist/lithentDevHelper.mjs"
      },
      "require": {
        "types": "./devHelper/dist/index.d.cts",
        "default": "./devHelper/dist/lithentDevHelper.cjs"
      }
    },
    "./ssr": {
      "import": {
        "types": "./ssr/dist/index.d.ts",
        "default": "./ssr/dist/lithentSsr.mjs"
      },
      "require": {
        "types": "./ssr/dist/index.d.cts",
        "default": "./ssr/dist/lithentSsr.cjs"
      }
    },
    "./tag": {
      "import": {
        "types": "./tag/dist/index.d.ts",
        "default": "./tag/dist/lithentTag.mjs"
      },
      "require": {
        "types": "./tag/dist/index.d.cts",
        "default": "./tag/dist/lithentTag.cjs"
      }
    },
    "./ftags": {
      "import": {
        "types": "./ftags/dist/index.d.ts",
        "default": "./ftags/dist/lithentFTags.mjs"
      },
      "require": {
        "types": "./ftags/dist/index.d.cts",
        "default": "./ftags/dist/lithentFTags.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./element/dist/index.d.ts",
        "default": "./element/dist/lithentElement.mjs"
      },
      "require": {
        "types": "./element/dist/index.d.cts",
        "default": "./element/dist/lithentElement.cjs"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist",
    "jsx-runtime/dist",
    "jsx-runtime/src",
    "jsx-runtime/package.json",
    "helper/dist",
    "helper/src",
    "helper/package.json",
    "devHelper/dist",
    "devHelper/src",
    "devHelper/package.json",
    "ssr/dist",
    "ssr/src",
    "ssr/package.json",
    "tag/dist",
    "tag/src",
    "tag/package.json",
    "ftags/dist",
    "ftags/src",
    "ftags/package.json",
    "element/dist",
    "element/src",
    "element/package.json",
    "examples/dist",
    "examples/src",
    "examples/package.json"
  ],
  "sideEffects": false,
  "author": "superlucky84",
  "repository": {
    "type": "git",
    "url": "https://github.com/superlucky84/lithent.git"
  },
  "homepage": "https://github.com/superlucky84/lithent",
  "license": "MIT",
  "keywords": [
    "lithent"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "happy-dom": "^9.20.3",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "terser": "^5.18.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-dts": "^2.3.0",
    "vitest": "^2.1.2"
  },
  "volta": {
    "node": "20.3.0",
    "pnpm": "9.12.3"
  }
}
