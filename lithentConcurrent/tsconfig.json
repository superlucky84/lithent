{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "node",
    "declaration": true,
    "allowJs": false,
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "rootDir": "..",
    "baseUrl": "./",
    "types": ["vitest/importMeta"],
    "paths": {
      "@/index": ["src/index.ts"],
      "@/wDom": ["src/wDom.ts"],
      "@/diff": ["src/diff.ts"],
      "@/render": ["src/render.ts"],
      "@/scheduler": ["src/scheduler.ts"],
      "@/utils/redraw": ["src/scheduler.ts"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist"]
}
