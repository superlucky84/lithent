{
  "type": "module",
  "name": "@lithent/lithent-vite",
  "version": "0.3.5",
  "description": "Vite plugin that wires Lithent-specific HMR boundaries and utilities.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:plugin": "vite --config vite.config.plugin.ts",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run --reporter verbose",
    "test:dev": "vitest"
  },
  "dependencies": {
    "@lithent/hmr-parser": "workspace:*",
    "@lithent/lithent-template-vite": "workspace:*"
  },
  "devDependencies": {
    "lithent": "workspace:*",
    "rollup": "^4.0.0",
    "vite": "^8.3.6"
  },
  "keywords": [
    "lithent",
    "vite",
    "hmr"
  ],
  "author": "superlucky84",
  "license": "MIT",
  "homepage": "https://github.com/superlucky84/lithent",
  "repository": {
    "type": "git",
    "url": "https://github.com/superlucky84/lithent.git"
  },
  "peerDependencies": {
    "lithent": "^1.25.0",
    "vite": "^8.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "packageManager": "pnpm@12.15.0"
}
