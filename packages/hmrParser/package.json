{
  "type": "module",
  "name": "@lithent/hmr-parser",
  "version": "0.2.5",
  "description": "Lithent HMR parser utilities for build tools",
  "packageManager": "pnpm@12.15.0",
  "main": "./dist/lithentHmrParser.cjs",
  "module": "./dist/lithentHmrParser.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/lithentHmrParser.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/lithentHmrParser.cjs"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run --reporter verbose",
    "test:dev": "vitest"
  },
  "author": "superlucky84",
  "repository": {
    "type": "git",
    "url": "https://github.com/superlucky84/lithent.git"
  },
  "homepage": "https://github.com/superlucky84/lithent",
  "license": "MIT",
  "keywords": [
    "lithent",
    "hmr",
    "parser"
  ],
  "dependencies": {
    "@babel/parser": "^7.26.2",
    "@babel/types": "^7.26.0",
    "magic-string": "^0.30.11"
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "lithent": "workspace:*",
    "@types/babel__traverse": "^7.20.6",
    "vite": "^8.3.6",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12"
  }
}
