{
  "name": "lithent-widget-compare",
  "private": true,
  "type": "module",
  "description": "The create-lithent widget built with lithent, React, Preact and Lit, for a size and load-time comparison.",
  "scripts": {
    "build": "pnpm run type-check && pnpm run lint && node scripts/build.mjs",
    "type-check": "tsc -p src/react && tsc -p src/preact && tsc -p src/lit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "measure": "node scripts/measure.mjs",
    "page": "node scripts/page.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@lithent/lithent-vite": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "lit": "3.3.3",
    "preact": "11.2.0",
    "prettier": "^3.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^8.3.6"
  }
}
